# API endpoint, not the GMS web console URL.
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 1 = deterministic adapter responses; always uses mock.db rather than app.db.
MOCK_LLM=0
MOCK_SCENARIO=normal

# Optional tracing. Enable only for material allowed to be sent to this project.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Initial retrieval settings; tune with the day-two evaluation questions.
MIN_SCORE=0.2
RELATIVE_MARGIN=0.1
MAX_EVIDENCE=12
MAX_EVIDENCE_CHARS=8000
MAX_UPLOAD_BYTES=31457280
REQUEST_TIMEOUT=30
HTTP_TIMEOUT=20
